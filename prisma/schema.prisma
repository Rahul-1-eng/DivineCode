generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                 @id @default(cuid())
  username            String                 @unique
  email               String                 @unique
  passwordHash        String?
  name                String?
  avatarUrl           String?
  role                UserRole               @default(USER)
  rating              Int                    @default(1200)
  duelRating          Int                    @default(1200)
  globalRating        Int                    @default(1200)
  coins               Int                    @default(0)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  
  auditLogs           AuditLog[]
  createdContests     Contest[]
  contestParticipants ContestParticipant[]
  contestProblemsAdded ContestProblem[]
  duelMatchesCreated  DuelMatch[]
  duelPlayers         DuelPlayer[]
  externalHandles     ExternalHandle[]
  interviewProgress   InterviewProgress[]
  authoredProblems    Problem[]
  ratingHistory       RatingHistory[]
  recommendationSnapshots RecommendationSnapshot[]
  submissions         Submission[]
  topicMastery        TopicMastery[]
  submissionReports   SubmissionReport[]
  submittedInterviewQuestions InterviewQuestion[]  
  teamMessages        TeamMessage[]          
  firstTeamSolves     TeamProblemSolve[]     
  unlockedTestcases   UnlockedTestcase[]     // NEW: Track unlocked hints/cases
}

model ExternalHandle {
  id                 String                  @id @default(cuid())
  userId             String
  platform           Platform
  handle             String
  externalUserId     String?
  rating             Int?
  maxRating          Int?
  status             HandleVerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  lastSyncAt         DateTime?
  rawProfile         Json?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  
  contestParticipants ContestParticipant[]
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([platform, handle])
  @@unique([userId, platform])
  @@index([userId])
}

model Topic {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  parentId      String?
  problemTopics ProblemTopic[]
  parent        Topic?         @relation("TopicTree", fields: [parentId], references: [id])
  children      Topic[]        @relation("TopicTree")
  topicMastery  TopicMastery[]

  @@index([parentId])
}

model Testcase {
  id             String               @id @default(cuid())
  problemId      String
  type           TestcaseType         @default(HIDDEN)
  input          String               @db.Text
  expectedOutput String               @db.Text
  explanation    String?
  weight         Int                  @default(1)
  order          Int                  @default(0)
  isPublic       Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  
  testResults    SubmissionTestResult[]
  problem        Problem              @relation(fields: [problemId], references: [id], onDelete: Cascade)
  unlockedBy     UnlockedTestcase[]   // NEW: Relation for point deductions

  @@index([problemId, type])
}

// NEW: Track which users/teams paid 50 points to unlock specific testcases
model UnlockedTestcase {
  id               String   @id @default(cuid())
  userId           String
  teamId           String?
  contestProblemId String
  testcaseId       String
  unlockedAt       DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  testcase       Testcase       @relation(fields: [testcaseId], references: [id], onDelete: Cascade)
  contestProblem ContestProblem @relation(fields: [contestProblemId], references: [id], onDelete: Cascade)
  team           ContestTeam?   @relation(fields: [teamId], references: [id])

  @@unique([userId, testcaseId])
  @@index([teamId])
}

model Problem {
  id                String             @id @default(cuid())
  slug              String?            @unique
  title             String
  tags              String[]
  source            ProblemSource      @default(INTERNAL)
  platform          Platform           @default(DIVINECODE)
  visibility        ProblemVisibility  @default(PUBLIC)
  checkerType       CheckerType        @default(EXACT)
  createdAt         DateTime           @default(now())
  authorId          String?
  boilerplateJson   String?
  description       String             @db.Text
  imageUrl          String?            
  problemCode       String             @unique
  rating            Int?
  url               String?
  
  contestProblems   ContestProblem[]
  duelRounds        DuelRound[]
  editorial         Editorial?
  officialSolutions OfficialSolution[]
  author            User?              @relation(fields: [authorId], references: [id])
  problemTopics     ProblemTopic[]
  submissions       Submission[]
  testcases         Testcase[]
}

model Submission {
  id                   String               @id @default(cuid())
  userId               String
  participantId        String?
  problemId            String?
  contestId            String?
  teamId               String?              
  contestProblemId     String?
  source               SubmissionSource     @default(INTERNAL_JUDGE)
  status               SubmissionStatus     @default(QUEUED)
  verdict              Verdict              @default(PENDING)
  language             String
  code                 String               @db.Text
  externalSubmissionId String?
  externalCreatedAt    DateTime?
  timeMs               Int?
  memoryKb             Int?
  judgeMessage         String?              @db.Text
  
  aiFeedback           String?              @db.Text
  aiComplexity         String?
  aiSimilarityScore    Float?
  isPlagiarized        Boolean              @default(false)

  createdAt            DateTime             @default(now())
  judgedAt             DateTime?
  
  contest              Contest?             @relation(fields: [contestId], references: [id], onDelete: Cascade)
  contestProblem       ContestProblem?      @relation(fields: [contestProblemId], references: [id])
  participant          ContestParticipant?  @relation(fields: [participantId], references: [id])
  problem              Problem?             @relation(fields: [problemId], references: [id])
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  team                 ContestTeam?         @relation(fields: [teamId], references: [id]) 
  testResults          SubmissionTestResult[]
  isFlagged            Boolean              @default(false)
  manualPoints         Int? 
  reports              SubmissionReport[] 

  @@unique([source, externalSubmissionId])
  @@index([contestId, createdAt]) 
  @@index([userId])
}

model SubmissionReport {
  id           String       @id @default(cuid())
  submissionId String
  reporterId   String
  reason       String       @db.Text 
  status       ReportStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  submission   Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reporter     User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([submissionId, reporterId]) 
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

model OfficialSolution {
  id          String   @id @default(cuid())
  problemId   String
  language    String
  code        String   @db.Text
  complexity  String?
  explanation String   @db.Text
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
}

model Editorial {
  id           String    @id @default(cuid())
  problemId    String    @unique
  title        String
  bodyMarkdown String    @db.Text
  hints        Json?
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  problem      Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// COLLABORATION MODELS (Team, Chat & Scoring)
// -----------------------------------------------------------------------------
model ContestTeam {
  id             String               @id @default(cuid())
  contestId      String
  name           String
  inviteCode     String               @unique @default(cuid())
  score          Int                  @default(0)
  penalty        Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  contest        Contest              @relation(fields: [contestId], references: [id], onDelete: Cascade)
  participants   ContestParticipant[]
  submissions    Submission[]
  messages       TeamMessage[]
  solvedProblems TeamProblemSolve[]   
  unlockedCases  UnlockedTestcase[]   

  @@index([contestId])
}

model TeamProblemSolve {
  id               String         @id @default(cuid())
  teamId           String
  contestProblemId String
  firstSolverId    String         
  solvedAt         DateTime       @default(now())

  team             ContestTeam    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contestProblem   ContestProblem @relation(fields: [contestProblemId], references: [id], onDelete: Cascade)
  firstSolver      User           @relation(fields: [firstSolverId], references: [id], onDelete: Cascade)

  @@unique([teamId, contestProblemId]) 
}

model TeamMessage {
  id        String      @id @default(cuid())
  contestId String
  teamId    String
  senderId  String
  content   String      @db.Text
  createdAt DateTime    @default(now())

  contest   Contest     @relation(fields: [contestId], references: [id], onDelete: Cascade)
  team      ContestTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sender    User        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
}
// -----------------------------------------------------------------------------

model Contest {
  id                           String               @id @default(cuid())
  inviteCode                   String               @unique
  title                        String
  description                  String?              @db.Text
  type                         ContestType          @default(GROUP)
  status                       ContestStatus        @default(DRAFT)
  startTime                    DateTime
  endTime                      DateTime
  freezeTime                   DateTime?
  durationMinutes              Int
  isRated                      Boolean              @default(false)
  allowLateJoin                Boolean              @default(false)
  hideProblemMetaDuringContest Boolean              @default(true)
  allowTeamSubmissionView      Boolean              @default(true)
  createdById                  String?
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  
  auditLogs                    AuditLog[]
  createdBy                    User?                @relation(fields: [createdById], references: [id])
  participants                 ContestParticipant[]
  problems                     ContestProblem[]
  standings                    ContestStanding[]
  syncJobs                     ExternalSyncJob[]
  ratingEvents                 RatingHistory[]
  submissions                  Submission[]
  teams                        ContestTeam[]        
  teamMessages                 TeamMessage[]        

  @@index([status, startTime])
  @@index([createdById])
}

model ContestParticipant {
  id               String                 @id @default(cuid())
  contestId        String
  userId           String?
  externalHandleId String?
  displayName      String
  teamName         String?                
  teamId           String?                
  role             ContestParticipantRole @default(PARTICIPANT)
  isOfficial       Boolean                @default(true)
  ratingBefore     Int?
  ratingAfter      Int?
  joinedAt         DateTime               @default(now())
  score            Int                    @default(0)

  contest          Contest                @relation(fields: [contestId], references: [id], onDelete: Cascade)
  team             ContestTeam?           @relation(fields: [teamId], references: [id]) 
  externalHandle   ExternalHandle?        @relation(fields: [externalHandleId], references: [id])
  user             User?                  @relation(fields: [userId], references: [id])
  standing         ContestStanding?
  submissions      Submission[]
  
  @@index([contestId])
  @@index([userId])
  @@unique([contestId, userId])
  @@index([contestId, teamName])
  @@index([externalHandleId])
}

model ContestProblem {
  id                  String             @id @default(cuid())
  contestId           String
  problemId           String?
  interviewQuestionId String?
  titleSnapshot       String
  platform            Platform           @default(DIVINECODE)
  externalId          String?
  externalUrl         String?
  imageUrl            String?            
  requiresRedirect    Boolean            @default(false) 
  aiExtractionStatus  ExtractionStatus   @default(COMPLETED) 
  index               Int
  label               String
  points              Int                @default(1000)
  isLocked            Boolean            @default(false)
  addedById           String?
  addedAt             DateTime           @default(now())
  isMCQ                 Boolean @default(false)
  mcqTimeLimitSeconds   Int     @default(0)
  mcqData               Json?
  addedBy             User?              @relation(fields: [addedById], references: [id])
  contest             Contest            @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem             Problem?           @relation(fields: [problemId], references: [id])
  interviewQuestion   InterviewQuestion? @relation(fields: [interviewQuestionId], references: [id])
  submissions         Submission[]
  teamSolves          TeamProblemSolve[] 
  unlockedCases       UnlockedTestcase[] 
  customTitle         String?
  customDescription   String?            @db.Text
  customTestCases     Json?              
  order               Int                @default(0)
  
  @@unique([contestId, index])
  @@unique([contestId, label])
  @@index([contestId])
  @@index([problemId])
  @@map("contest_problems")
}

model SubmissionTestResult {
  id             String     @id @default(cuid())
  submissionId   String
  testcaseId     String?
  index          Int
  verdict        Verdict
  timeMs         Int?
  memoryKb       Int?
  stdout         String?    @db.Text
  stderr         String?    @db.Text
  checkerMessage String?    @db.Text
  
  submission     Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testcase       Testcase?  @relation(fields: [testcaseId], references: [id])

  @@unique([submissionId, index])
}

model ProblemTopic {
  problemId String
  topicId   String
  id        String  @id @default(uuid())
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  topic     Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([problemId, topicId])
}

model ContestStanding {
  id               String             @id @default(cuid())
  contestId        String
  participantId    String             @unique
  rank             Int?
  solved           Int                @default(0)
  penalty          Int                @default(0)
  score            Int                @default(0)
  individualScore  Int                @default(0) 
  individualSolved Int                @default(0)
  testcasePenalty  Int                @default(0) 
  solvedProblemIds String[]
  lastAcceptedAt   DateTime?
  updatedAt        DateTime           @updatedAt
  
  contest          Contest            @relation(fields: [contestId], references: [id], onDelete: Cascade)
  participant      ContestParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([contestId, rank])
  @@index([contestId, solved, penalty])
}

model ExternalSyncJob {
  id               String              @id @default(cuid())
  contestId        String?
  platform         Platform
  targetKind       String
  targetId         String
  status           ExternalSyncStatus  @default(PENDING)
  cursor           String?
  lastSubmissionId String?
  error            String?             @db.Text
  nextRunAt        DateTime?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  
  events           ExternalSyncEvent[]
  contest          Contest?            @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@index([platform, targetKind, targetId])
  @@index([status, nextRunAt])
}

model ExternalSyncEvent {
  id                   String           @id @default(cuid())
  syncJobId            String?
  platform             Platform
  externalSubmissionId String
  accepted             Boolean          @default(false)
  payload              Json
  processedAt          DateTime?
  createdAt            DateTime         @default(now())
  
  syncJob              ExternalSyncJob? @relation(fields: [syncJobId], references: [id])

  @@unique([platform, externalSubmissionId])
  @@index([syncJobId])
}

model DuelMatch {
  id              String          @id @default(cuid())
  mode            DuelMode        @default(MCQ)
  status          DuelStatus      @default(WAITING)
  roomId          String          @unique
  createdById     String?
  questionSeconds Int             @default(20)
  isRated         Boolean         @default(true)
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  createdBy       User?           @relation(fields: [createdById], references: [id])
  players         DuelPlayer[]
  rounds          DuelRound[]
  ratingEvents    RatingHistory[]
}

model DuelPlayer {
  id           String       @id @default(cuid())
  duelId       String
  userId       String?
  displayName  String
  socketId     String?
  score        Int          @default(0)
  ratingBefore Int?
  ratingAfter  Int?
  rank         Int?
  joinedAt     DateTime     @default(now())
  leftAt       DateTime?
  
  answers      DuelAnswer[]
  duel         DuelMatch    @relation(fields: [duelId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@unique([duelId, userId])
  @@index([duelId, score])
}

model DuelRound {
  id               String       @id @default(cuid())
  duelId           String
  problemId        String?
  prompt           String       @db.Text
  options          Json?
  correctAnswer    Json?
  topic            String?
  difficultyRating Int?
  order            Int
  startedAt        DateTime?
  endedAt          DateTime?
  
  answers          DuelAnswer[]
  duel             DuelMatch    @relation(fields: [duelId], references: [id], onDelete: Cascade)
  problem          Problem?     @relation(fields: [problemId], references: [id])

  @@unique([duelId, order])
}

model DuelAnswer {
  id         String     @id @default(cuid())
  roundId    String
  playerId   String
  answer     Json
  isCorrect  Boolean
  responseMs Int?
  scoreDelta Int        @default(0)
  createdAt  DateTime   @default(now())
  
  player     DuelPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  round      DuelRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, playerId])
}

model RatingHistory {
  id               String          @id @default(cuid())
  userId           String
  eventType        RatingEventType
  oldRating        Int
  newRating        Int
  delta            Int
  reason           String
  contestId        String?
  duelId           String?
  externalPlatform Platform?
  createdAt        DateTime        @default(now())
  
  contest          Contest?        @relation(fields: [contestId], references: [id])
  duel             DuelMatch?      @relation(fields: [duelId], references: [id])
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model TopicMastery {
  id              String    @id @default(cuid())
  userId          String
  topicId         String
  ability         Float     @default(0)
  attempts        Int       @default(0)
  solved          Int       @default(0)
  lastPracticedAt DateTime?
  updatedAt       DateTime  @updatedAt
  
  topic           Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
}

model RecommendationSnapshot {
  id          String   @id @default(cuid())
  userId      String
  reason      String
  ratingFloor Int
  ratingCeil  Int
  topicWeights Json
  problemIds  String[]
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model InterviewTrack {
  id          String              @id @default(cuid())
  slug        String              @unique
  title       String
  type        InterviewTrackType
  description String?             @db.Text
  order       Int                 @default(0)
  questions   InterviewQuestion[]
}

model InterviewQuestion {
  id               String              @id @default(cuid())
  trackId          String
  title            String
  prompt           String              @db.Text
  
  options          Json?               
  correctIndex     Int?                
  correctIndices   Int[]               
  isMultiple       Boolean             @default(false) 
  difficulty       String              @default("Medium") 
  
  expectedAnswer   String?             @db.Text
  tags             String[]
  sourceCompany    String?
  isApproved       Boolean             @default(true) 
  submittedById    String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  
  progress         InterviewProgress[]
  track            InterviewTrack      @relation(fields: [trackId], references: [id], onDelete: Cascade)
  submittedBy      User?               @relation(fields: [submittedById], references: [id])
  contestProblems  ContestProblem[]    

  @@index([trackId])
}

model InterviewProgress {
  id             String            @id @default(cuid())
  userId         String
  questionId     String
  status         String            @default("NOT_STARTED")
  confidence     Int?
  notes          String?           @db.Text
  lastReviewedAt DateTime?
  updatedAt      DateTime          @updatedAt
  
  question       InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model AiProblemDataset {
  id              String   @id @default(cuid())
  title           String
  descriptionHtml String   @db.Text
  platform        String   
  originalUrl     String?
  tags            String[] 
  difficulty      String
  testcases       Json     
  createdAt       DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  contestId  String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  
  actor      User?    @relation(fields: [actorId], references: [id])
  contest    Contest? @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@index([contestId, createdAt])
  @@index([actorId, createdAt])
}

enum UserRole {
  USER
  PROBLEM_SETTER
  ADMIN
}

enum Platform {
  DIVINECODE
  CODEFORCES
  LEETCODE
  ATCODER
  CODECHEF
  HACKERRANK
  OTHER
}

enum HandleVerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

enum ProblemSource {
  INTERNAL
  EXTERNAL
}

enum ProblemVisibility {
  DRAFT
  PRIVATE
  PUBLIC
  ARCHIVED
}

enum TestcaseType {
  SAMPLE
  PRETEST
  HIDDEN
  SYSTEM
  STRESS
}

enum CheckerType {
  EXACT
  TOKEN
  FLOAT
  CUSTOM
}

enum ContestType {
  SOLO
  GROUP
  MASHUP
  DUEL_TOURNAMENT
}

enum ContestStatus {
  DRAFT
  SCHEDULED
  RUNNING
  FROZEN
  ENDED
  CANCELLED
}

enum ContestParticipantRole {
  OWNER
  MANAGER
  PARTICIPANT
  OBSERVER
}

enum SubmissionSource {
  INTERNAL_JUDGE
  EXTERNAL_SYNC
  MANUAL_ADMIN
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  FINISHED
  FAILED
}

enum Verdict {
  ACCEPTED
  WRONG_ANSWER
  COMPILATION_ERROR
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  PRESENTATION_ERROR
  JUDGE_ERROR
  SECURITY_VIOLATION
  PENDING
  SKIPPED
}

enum ExternalSyncStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  PAUSED
}

enum DuelMode {
  MCQ
  DEBUGGING
  COUNTEREXAMPLE
  CODE_SPRINT
  HYBRID
}

enum DuelStatus {
  WAITING
  RUNNING
  FINISHED
  CANCELLED
}

enum RatingEventType {
  CONTEST
  DUEL
  EXTERNAL_SYNC
  ADMIN
}

enum InterviewTrackType {
  DSA
  OOPS
  DATABASE
  COMPILER
  OPERATING_SYSTEM
  NETWORKS
  SYSTEM_DESIGN
  BEHAVIORAL
}

enum ExtractionStatus {
  PENDING
  COMPLETED
  FAILED
  MANUAL
}