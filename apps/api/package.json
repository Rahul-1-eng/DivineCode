{
  "name": "divinecode-api",
  "version": "0.2.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev src/index.ts",
    "build": "prisma generate --schema=../../prisma/schema.prisma && tsc",
    "db:check": "ts-node-dev --respawn false --transpile-only src/scripts/checkDatabase.ts",
    "start": "node src/index.js",
    "worker:start": "node dist/workers/index.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.17.0",
    "bullmq": "^5.76.10",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "ioredis": "^5.10.1",
    "mongoose": "^8.9.5",
    "multer": "^2.1.1",
    "socket.io": "^4.8.3",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/express": "^4.17.17",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.10.0",
    "@types/socket.io": "^3.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0"
  }
}
