PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/divinecode?schema=public"
REDIS_URL="redis://localhost:6379"
ENABLE_API_WORKERS="false"

JUDGE0_URL="http://localhost:2358"
JUDGE0_API_KEY=""
JUDGE_WORKER_SECRET="change-this-worker-secret-before-production"
JUDGE_WORKER_CONCURRENCY=2
EXTERNAL_SYNC_WORKER_CONCURRENCY=2

MONGODB_URI=""
MONGODB_DB="divinecode"

# UPI handle that receives recruiter-booking payments (real money — set your own UPI ID)
PLATFORM_UPI_ID="yourname@upi"

# Gmail the platform sends from (App Password, not the account password:
# Google Account -> Security -> 2-Step Verification -> App passwords)
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Razorpay keys (dashboard.razorpay.com -> Settings -> API Keys). When set,
# bookings can be paid online: cards, UPI, netbanking, wallets. Leave empty
# to run manual-UPI-only.
RAZORPAY_KEY_ID="rzp_live_..."
RAZORPAY_KEY_SECRET="..."
