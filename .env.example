# API
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# PostgreSQL is the v2 source of truth.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/divinecode?schema=public"

# Redis powers live standings, matchmaking, and background queues.
REDIS_URL="redis://localhost:6379"
ENABLE_API_WORKERS="false"
JUDGE_WORKER_CONCURRENCY=2
EXTERNAL_SYNC_WORKER_CONCURRENCY=2

# Judge0
# Use a self-hosted Judge0 URL in production.
JUDGE0_URL="http://localhost:2358"
JUDGE0_API_KEY=""
JUDGE_WORKER_SECRET="change-this-worker-secret-before-production"

# Auth
JWT_SECRET="change-this-secret-before-production"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-secret-before-production"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# External platform sync
CODEFORCES_API_KEY=""
CODEFORCES_API_SECRET=""
EXTERNAL_SYNC_INTERVAL_SECONDS=30

# Object storage for large tests/editorials/assets, optional locally.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
